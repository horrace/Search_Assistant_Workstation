{
  "version": "0.2.0",
  "configurations": [
    {
		"name": "Debug Electron via npm run dev",
		"type": "node",
		"request": "launch",
		"runtimeExecutable": "npm",
		"runtimeArgs": [
			"run-script",
			"dev"
		],
		"cwd": "${workspaceFolder}",
		"console": "integratedTerminal",
		"outputCapture": "std",
		"autoAttachChildProcesses": true,
		"skipFiles": [
			"<node_internals>/**"
		]
    },
    {
		"name": "Debug Electron via npm run dev (D: portable Node)",
		"type": "node",
		"request": "launch",
		"runtimeExecutable": "D:/node-v24.14.0-win-x64/npm.cmd",
		"runtimeArgs": [
		  "run-script",
		  "dev"
		],
		"cwd": "${workspaceFolder}",
		"console": "integratedTerminal",
		"outputCapture": "std",
		"autoAttachChildProcesses": true,
		"skipFiles": [
		  "<node_internals>/**"
		],
		"env": {
		  "PATH": "D:/node-v24.14.0-win-x64;${env:PATH}"
		}
	},
    {
        "name": "Debug Main Process",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "program": "${workspaceFolder}/src/main.js",
        "env": {
            "NODE_ENV": "development"
        },
        "console": "integratedTerminal",
        "skipFiles": ["<node_internals>/**"]
    },
    {
        "name": "Debug Renderer Process", 
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3000",
        "webRoot": "${workspaceFolder}/src",
        "skipFiles": ["<node_internals>/**"]
    },


    {
        "name": "Debug Electron Main",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
        "windows": {
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
        },
        "args": ["."],
        "outputCapture": "std",
        "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Debug Both Processes",
      "configurations": ["Debug Main Process", "Debug Renderer Process"]
    }
  ]
} 